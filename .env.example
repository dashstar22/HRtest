# ============================================================
# 填入 DeepSeek API Key 后，服务会自动切换为「大模型语义匹配」模式
# 留空则使用内置规则引擎（模拟模式），流程同样可以完整演示
# ============================================================
DEEPSEEK_API_KEY=

# OpenAI 兼容端点，换用其他厂商时改这里即可
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 单次请求超时（秒）与批量筛选时的并发数
LLM_TIMEOUT=90
LLM_CONCURRENCY=3
